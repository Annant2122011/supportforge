DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Persistence
# Neon PostgreSQL is the authoritative live datastore.
# SQLite is disabled for bot runtime; the migration utility can still import
# a legacy SQLite database into PostgreSQL when explicitly requested.
SUPPORTFORGE_DATABASE_PROVIDER=postgres

# Neon pooled runtime connection
DATABASE_URL=

# Neon direct/unpooled migration/admin connection
DATABASE_URL_UNPOOLED=

# Optional secure GitHub Actions deployment trigger for Settings → Repair System → Restore & Update.
# Create a fine-grained token scoped to this repository with Actions: write only.
# Keep the token in the server's secret environment; never commit a real token.
GITHUB_DEPLOY_TOKEN=

# Optional runtime pool tuning
SUPPORTFORGE_DB_POOL_MAX=10
SUPPORTFORGE_DB_IDLE_TIMEOUT_MS=30000
SUPPORTFORGE_DB_CONNECTION_TIMEOUT_MS=10000

# Durable ticket recovery attachment limit (default 25 MiB per attachment).
# Increase only after reviewing Neon storage capacity and Discord upload limits.
TICKET_ARCHIVE_MAX_ATTACHMENT_BYTES=26214400
