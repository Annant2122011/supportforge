DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Persistence
# Keep sqlite during the migration/verification window.
# Switch to postgres only after the controlled SQLite → PostgreSQL migration
# has been verified.
SUPPORTFORGE_DATABASE_PROVIDER=sqlite

# Neon pooled runtime connection
DATABASE_URL=

# Neon direct/unpooled migration/admin connection
DATABASE_URL_UNPOOLED=

# Optional runtime pool tuning
SUPPORTFORGE_DB_POOL_MAX=10
SUPPORTFORGE_DB_IDLE_TIMEOUT_MS=30000
SUPPORTFORGE_DB_CONNECTION_TIMEOUT_MS=10000
